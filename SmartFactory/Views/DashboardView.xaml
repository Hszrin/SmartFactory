<UserControl x:Class="SmartFactory.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:SmartFactory.Views.Dashboard"
             Background="#1E1E1E">

    <Grid>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="생산 대시보드"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right"
                Orientation="Horizontal">

                <Button Content="오늘"
        Command="{Binding ChangePeriodCommand}"
        CommandParameter="Today"
        Width="70"
        Height="32"
        Margin="15,0,5,0"
        Foreground="White"
        BorderThickness="0"
        Background="{Binding SelectedPeriod,
            Converter={StaticResource PeriodButtonBrushConverter},
            ConverterParameter=Today}"/>

                <Button Content="최근 7일"
        Command="{Binding ChangePeriodCommand}"
        CommandParameter="Last7Days"
        Width="80"
        Height="32"
        Margin="0,0,5,0"
        Foreground="White"
        BorderThickness="0"
        Background="{Binding SelectedPeriod,
            Converter={StaticResource PeriodButtonBrushConverter},
            ConverterParameter=Last7Days}"/>

                <Button Content="이번 달"
        Command="{Binding ChangePeriodCommand}"
        CommandParameter="ThisMonth"
        Width="80"
        Height="32"
        Margin="0,0,10,0"
        Foreground="White"
        BorderThickness="0"
        Background="{Binding SelectedPeriod,
            Converter={StaticResource PeriodButtonBrushConverter},
            ConverterParameter=ThisMonth}"/>
            </StackPanel>
        </DockPanel>

            <TextBlock Grid.Row="1"
           Text="{Binding ErrorMessage}"
           Foreground="#FF6B6B"
           Margin="0,0,0,10"
           TextWrapping="Wrap"/>

            <!-- 요약 -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="생산량" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.TotalProduction}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="양품 수량" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.GoodQuantity}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="불량 수량" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.DefectQuantity}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="불량률" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.DefectRate, StringFormat={}{0:F2}%}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="진행중 작업지시" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.RunningWorkOrderCount}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="5" Background="#2A2A2A" CornerRadius="6"
                    Padding="15" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="완료 작업지시" Foreground="#BBBBBB"/>
                    <TextBlock Text="{Binding Summary.CompletedWorkOrderCount}"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 상세 패널 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <dashboard:MachineProductionPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,8"/>

            <dashboard:ProductProductionPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,8"/>

            <dashboard:DefectTypePanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,8,0"/>

            <dashboard:WorkOrderProgressPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="8,8,0,0"/>
        </Grid>
        
    </Grid>
    <Border Background="#AA000000"
            Visibility="{Binding IsLoading,
                Converter={StaticResource BoolToVisibilityConverter}}">

        <TextBlock Text="조회 중..."
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>

    </Grid>
</UserControl>