<UserControl x:Class="SmartFactory.Views.ProductionPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Text="생산 계획 관리"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 입력 영역 -->
        <Border Grid.Row="1"
                Background="#2A2A2A"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="제품"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="ProductName"
                          Height="30"/>

                <TextBlock Grid.Column="2"
                           Text="라인"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}"
                          DisplayMemberPath="LineName"
                          Height="30"/>

                <TextBlock Grid.Column="4"
                           Text="목표수량"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="5"
                         Text="{Binding TargetQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <TextBlock Grid.Column="6"
                           Text="시작일"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <DatePicker Grid.Column="7"
                            SelectedDate="{Binding StartDate}"
                            Height="30"/>

                <TextBlock Grid.Column="8"
                           Text="종료일"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <DatePicker Grid.Column="9"
                            SelectedDate="{Binding EndDate}"
                            Height="30"/>

                <TextBlock Grid.Column="10"
                           Text="상태"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <ComboBox Grid.Column="11"
                          ItemsSource="{Binding StatusList}"
                          SelectedItem="{Binding Status}"
                          Height="30"/>

                <StackPanel Grid.Column="12"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="등록"
                            Command="{Binding AddPlanCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#2E7D32"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="수정"
                            Command="{Binding UpdatePlanCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#1565C0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="삭제"
                            Command="{Binding DeleteCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#B71C1C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="새로고침"
                            Command="{Binding RefreshCommand}"
                            Width="90"
                            Height="32"
                            Margin="5,0"
                            Background="#555"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 목록 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Plans}"
                  SelectedItem="{Binding SelectedPlan}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#252525"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White"
                  BorderBrush="#444"
                  GridLinesVisibility="Horizontal">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="계획 ID"
                                    Binding="{Binding PlanId}"
                                    Width="80"/>

                <DataGridTextColumn Header="제품"
                                    Binding="{Binding Product.ProductName}"
                                    Width="150"/>

                <DataGridTextColumn Header="라인"
                                    Binding="{Binding Line.LineName}"
                                    Width="120"/>

                <DataGridTextColumn Header="목표수량"
                                    Binding="{Binding TargetQuantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="시작일"
                                    Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}"
                                    Width="120"/>

                <DataGridTextColumn Header="종료일"
                                    Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}"
                                    Width="120"/>

                <DataGridTextColumn Header="상태"
                                    Binding="{Binding Status}"
                                    Width="110"/>

                <DataGridTextColumn Header="등록일"
                                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>