<UserControl x:Class="SmartFactory.Views.ProductionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Text="생산 실적 관리"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 입력 영역 -->
        <Border Grid.Row="1"
                Background="#2A2A2A"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 작업지시 -->
                <TextBlock Text="작업지시"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding WorkOrders}"
                          SelectedItem="{Binding SelectedWorkOrder}"
                          DisplayMemberPath="WorkOrderId"
                          Height="30"/>

                <!-- 설비 -->
                <TextBlock Grid.Column="2"
                           Text="설비"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Machines}"
                          SelectedItem="{Binding SelectedMachine}"
                          DisplayMemberPath="MachineName"
                          Height="30"/>

                <!-- 생산수량 -->
                <TextBlock Grid.Column="4"
                           Text="생산수량"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="5"
                         Text="{Binding ProductionQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <!-- 양품 -->
                <TextBlock Grid.Column="6"
                           Text="양품"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="7"
                         Text="{Binding GoodQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <!-- 불량 -->
                <TextBlock Grid.Column="8"
                           Text="불량"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="9"
                         Text="{Binding DefectQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <!-- 버튼 -->
                <StackPanel Grid.Column="10"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="등록"
                            Command="{Binding AddResultCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#2E7D32"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="수정"
                            Command="{Binding UpdateResultCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#1565C0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="삭제"
                            Command="{Binding DeleteCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#B71C1C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="새로고침"
                            Command="{Binding RefreshCommand}"
                            Width="90"
                            Height="32"
                            Margin="5,0"
                            Background="#555"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 생산 실적 목록 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedResult}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#252525"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White"
                  BorderBrush="#444"
                  GridLinesVisibility="Horizontal">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground"
                            Value="Black"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="실적 ID"
                                    Binding="{Binding ResultId}"
                                    Width="80"/>

                <DataGridTextColumn Header="작업지시"
                                    Binding="{Binding WorkOrderId}"
                                    Width="90"/>

                <DataGridTextColumn Header="설비"
                                    Binding="{Binding Machine.MachineName}"
                                    Width="160"/>

                <DataGridTextColumn Header="제품"
                                    Binding="{Binding WorkOrder.Product.ProductName}"
                                    Width="140"/>

                <DataGridTextColumn Header="생산수량"
                                    Binding="{Binding ProductionQuantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="양품"
                                    Binding="{Binding GoodQuantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="불량"
                                    Binding="{Binding DefectQuantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="생산시간"
                                    Binding="{Binding ProductionTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="180"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>