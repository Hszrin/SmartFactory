<UserControl x:Class="SmartFactory.Views.WorkOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="작업지시 관리"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="#2A2A2A"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="생산계획"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Plans}"
                          SelectedItem="{Binding SelectedPlan}"
                          DisplayMemberPath="PlanId"
                          Height="30"/>

                <TextBlock Grid.Column="2"
                           Text="목표수량"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="3"
                         Text="{Binding TargetQuantity}"
                         Height="30"/>

                <TextBlock Grid.Column="4"
                           Text="상태"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <ComboBox Grid.Column="5"
                          ItemsSource="{Binding StatusList}"
                          SelectedItem="{Binding Status}"
                          Height="30"/>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="등록"
                            Command="{Binding AddWorkOrderCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#2E7D32"
                            Foreground="White"/>

                    <Button Content="수정"
                            Command="{Binding UpdateWorkOrderCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#1565C0"
                            Foreground="White"/>

                    <Button Content="삭제"
                            Command="{Binding DeleteCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#B71C1C"
                            Foreground="White"/>

                    <Button Content="새로고침"
                            Command="{Binding RefreshCommand}"
                            Width="90"
                            Height="32"
                            Margin="5,0"
                            Background="#555"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding WorkOrders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#252525"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding WorkOrderId}"
                                    Width="60"/>

                <DataGridTextColumn Header="계획"
                                    Binding="{Binding PlanId}"
                                    Width="70"/>

                <DataGridTextColumn Header="제품"
                                    Binding="{Binding Product.ProductName}"
                                    Width="150"/>

                <DataGridTextColumn Header="라인"
                                    Binding="{Binding Line.LineName}"
                                    Width="100"/>

                <DataGridTextColumn Header="목표수량"
                    Binding="{Binding TargetQuantity}"
                    Width="90"/>

                <DataGridTextColumn Header="현재수량"
                    Binding="{Binding CurrentQuantity}"
                    Width="90"/>

                <DataGridTextColumn Header="상태"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTextColumn Header="시작시간"
                                    Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="170"/>

                <DataGridTextColumn Header="종료시간"
                                    Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>