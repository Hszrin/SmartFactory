<UserControl x:Class="SmartFactory.Views.Dashboard.ProductProductionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Border Background="#2A2A2A"
            BorderBrush="#444"
            BorderThickness="1"
            CornerRadius="6"
            Padding="15"
            MinHeight="300">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="제품별 생산량"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="Bold"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,10,0,10">

                <Button Content="그래프"
                        Command="{Binding ChangeProductModeCommand}"
                        CommandParameter="True"
                        Width="70"
                        Height="28"
                        Margin="0,0,5,0"
                        Background="{Binding IsProductChartMode,
            Converter={StaticResource ModeButtonBrushConverter},
            ConverterParameter=Chart}"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="표"
                        Command="{Binding ChangeProductModeCommand}"
                        CommandParameter="False"
                        Width="70"
                        Height="28"
                        Background="{Binding IsProductChartMode,
            Converter={StaticResource ModeButtonBrushConverter},
            ConverterParameter=Table}"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
            
            <Grid Grid.Row="2">
                <Grid Visibility="{Binding HasProductData,
        Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <lvc:CartesianChart Grid.Row="2"
                                MinHeight="250"
                                Background="#2A2A2A"
                                Series="{Binding ProductSeries}"
                                XAxes="{Binding ProductXAxes}"
                                YAxes="{Binding ProductYAxes}"
                                Visibility="{Binding IsProductChartMode,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding ProductProductions}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="#252525"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#2D2D2D"
                      Foreground="White"
                      BorderBrush="#444"
                      Visibility="{Binding IsProductChartMode,
                          Converter={StaticResource InverseBoolToVisibilityConverter}}">


            <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="제품"
                                        Binding="{Binding ProductName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="생산량"
                                        Binding="{Binding ProductionQuantity}"
                                        Width="120"/>
                </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <TextBlock Text="조회된 데이터가 없습니다."
               Foreground="#888"
               FontSize="15"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="{Binding HasMachineData,
                   Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>