<UserControl x:Class="SmartFactory.Views.Dashboard.WorkOrderProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#2A2A2A"
            BorderBrush="#444"
            BorderThickness="1"
            CornerRadius="6"
            Padding="15"
            MinHeight="300">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="작업지시 진행률"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding WorkOrderProgresses}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="#252525"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#2D2D2D"
                      Foreground="White">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="Black"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="작업지시"
                                        Binding="{Binding WorkOrderId}"
                                        Width="80"/>
                    
                    <DataGridTextColumn Header="상태"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                    <DataGridTextColumn Header="제품"
                                        Binding="{Binding ProductName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="현재"
                                        Binding="{Binding CurrentQuantity}"
                                        Width="70"/>

                    <DataGridTextColumn Header="목표"
                                        Binding="{Binding TargetQuantity}"
                                        Width="70"/>

                    <DataGridTemplateColumn Header="진행률" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressRate}"
                             Height="20"
                             VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding ProgressRate, StringFormat={}{0:F1}%}"
           Foreground="White"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>