<UserControl x:Class="SmartFactory.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Text="제품 관리"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- 입력 영역 -->
        <Border Grid.Row="1"
                Background="#2A2A2A"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="제품 코드"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <TextBlock Grid.Column="2"
                           Text="제품명"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="3"
                         Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <TextBlock Grid.Column="4"
                           Text="단위"
                           Foreground="#BBBBBB"
                           VerticalAlignment="Center"
                           Margin="15,0,8,0"/>

                <TextBox Grid.Column="5"
                         Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"/>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="등록"
                            Command="{Binding AddProductCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#2E7D32"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="수정"
                            Command="{Binding UpdateProductCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#1565C0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="삭제"
                            Command="{Binding DeleteProductCommand}"
                            Width="80"
                            Height="32"
                            Margin="5,0"
                            Background="#B71C1C"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                    <Button Content="새로고침"
                            Command="{Binding RefreshProductsCommand}"
                            Width="90"
                            Height="32"
                            Margin="5,0"
                            Background="#555"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 목록 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#252525"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#2D2D2D"
                  Foreground="White"
                  BorderBrush="#444"
                  GridLinesVisibility="Horizontal">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ProductId}"
                                    Width="80"/>

                <DataGridTextColumn Header="제품 코드"
                                    Binding="{Binding ProductCode}"
                                    Width="150"/>

                <DataGridTextColumn Header="제품명"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="단위"
                                    Binding="{Binding Unit}"
                                    Width="100"/>

                <DataGridTextColumn Header="등록일"
                                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                    Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>