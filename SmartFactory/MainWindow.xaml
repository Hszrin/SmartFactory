<Window x:Class="SmartFactory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Factory MES"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 사이드 메뉴 -->
        <Border Grid.Column="0"
                Background="#252525">

            <StackPanel>
                <TextBlock Text="Smart Factory"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20"/>

                <Button Content="대쉬 보드"
                        Height="45"
                        Margin="10,5"
                        Click="DashboardButton_Click"/>

                <Button Content="제품 관리"
                        Height="45"
                        Margin="10,5"
                        Click="ProductButton_Click"/>

                <Button Content="설비 관리"
                        Height="45"
                        Margin="10,5"
                        Click="MachineButton_Click"/>

                <Button Content="라인 관리"
                        Height="45"
                        Margin="10,5"
                        Click="LineButton_Click"/>

                <Button Content="생산 계획"
                        Height="45"
                        Margin="10,5"
                        Click="ProductionPlanButton_Click"/>

                <Button Content="작업 지시"
                        Height="45"
                        Margin="10,5"
                        Click="WorkOrderButton_Click"/>
                
                <Button Content="생산 실적"
                    Height="45"
                    Margin="10,5"
                    Click="ProductionResultButton_Click"/>

                <Button Content="불량 관리"
                    Height="45"
                    Margin="10,5"
                    Click="DefectButton_Click"/>
            </StackPanel>
        </Border>

        <!-- 화면 표시 영역 -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>
    </Grid>
</Window>